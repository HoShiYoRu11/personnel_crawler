        function updateSubjectProperty(id, key, val) {
            const sub = subjects.find(s => s.id === id);
            if (!sub) return;
            if (key === 'weight') {
                sub.weight = Math.max(0, parseInt(val) || 0);
            } else if (key === 'name') {
                sub.name = val.trim() || `考科_${id}`;
            } else if (key === 'threshold') {
                sub.threshold = val.trim() === '' ? null : Math.max(0, parseFloat(val) || 0);
            } else {
                sub[key] = val;
            }
            renderSubjectsConfig();
            renderUserScoreInputs();
            renderColInputPasteBoxes();
        }

        // --- 4. 解析器 (智慧型佔位解析，完美支援 '?' 與 留空) ---
        let parsedCandidatesRows = []; 

        function parseRowInput() {
            const rawText = document.getElementById('otherScoresRow').value;
            const lines = rawText.split('\n');
            const result = [];

            lines.forEach(line => {
                const trimmed = line.trim();
                if (!trimmed) return;
                
                let tokens = [];
                if (trimmed.includes(',')) {
                    tokens = trimmed.split(',');
                } else {
                    tokens = trimmed.split(/\s+/);
                }

                const rowScores = tokens.map(token => {
                    const t = token.trim();
                    if (t === '?' || t === '' || isNaN(parseFloat(t))) {
                        return null;
                    }
                    const val = parseFloat(t);
                    return (val >= 0 && val <= 150) ? val : null;
                });

                if (rowScores.some(s => s !== null)) {
                    result.push(rowScores);
                }
            });

            parsedCandidatesRows = result;
            const rowParsedCount = document.getElementById('rowParsedCount');
            rowParsedCount.innerText = `已識別 ${result.length} 筆考生`;
            if (result.length > 0) {
                rowParsedCount.className = "text-[10px] bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold";
            } else {
                rowParsedCount.className = "text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded";
            }
        }

        function parseColInput() {
            const colData = {};
            subjects.forEach(sub => {
                const el = document.getElementById(`otherScoresCol_${sub.id}`);
                const text = el ? el.value : '';
                
                let tokens = [];
                if (text.includes(',')) {
                    tokens = text.split(',');
                } else {
                    tokens = text.split(/[\s\n]+/);
                }

                const scores = tokens.map(t => {
                    const val = parseFloat(t.trim());
                    if (t.trim() === '?' || isNaN(val)) return null;
                    return (val >= 0 && val <= 150) ? val : null;
                }).filter(t => t !== ''); 
                
                colData[sub.id] = scores;
            });
            return colData;
        }

        // --- 5. 智慧型截斷常態/特定分佈生成器 (核心防卡死算法) ---
        function generateSubjectScoreWithThreshold(sub, stats) {
            const threshold = parseFloat(sub.threshold);
            const hasThreshold = !isNaN(threshold) && threshold !== null && threshold > 0;
            
            let s = 0;
            let attempts = 0;
            const maxAttempts = 100; // 防呆安全上限，避開無限死循環
            
            do {
                if (sub.dist === 'normal') s = randomNormal(stats.mean, stats.std);
                else if (sub.dist === 'bounded') s = randomBounded70_90();
                else if (sub.dist === 'uniform') s = randomUniform(stats.mean - stats.std * 1.73, stats.mean + stats.std * 1.73);
                else if (sub.dist === 'triangular') s = randomTriangular(stats.mean - stats.std * 2.44, stats.mean + stats.std * 2.44, stats.mean);
                attempts++;
            } while (hasThreshold && s < threshold && attempts < maxAttempts);

            if (hasThreshold && s < threshold) {
                // 若隨機生成在 100 次內都無法越過最低錄取分數門檻，
                // 則直接在其「錄取門檻與滿分 100 分」之間進行平均抽樣，保證統計合理性。
                s = randomUniform(threshold, 100);
            }
            return s;
        }

        // --- 6. 核心蒙地卡羅演算法主體 ---
        let lastAnalysisResult = null;

        function runSimulation() {
            const totalWeight = subjects.reduce((sum, sub) => sum + sub.weight, 0);
            if (totalWeight !== 100) {
                showToast(`配分權重總和目前為 ${totalWeight}%，必須剛好為 100% 才能開始模擬！`, "error");
                return;
            }

            const totalN = parseInt(document.getElementById('totalCandidates').value) || 25;
            const qPlanned = parseInt(document.getElementById('quotaPlanned').value) || 8;
            const qActual = parseInt(document.getElementById('quotaActual').value) || 8;
            const knowCutoff = document.getElementById('knowCutoff').checked;
            const cutoffScore = parseFloat(document.getElementById('cutoffScore').value) || 0;
            const scoreRes = document.getElementById('scoreResolution').value;
            const trials = parseInt(document.getElementById('simTrials').value) || 10000;

            const userScores = {};
            let isUserScoreValid = true;
            subjects.forEach(sub => {
                const el = document.getElementById(`userScore_${sub.id}`);
                const val = parseFloat(el ? el.value : '0');
                if (isNaN(val) || val < 0) {
                    isUserScoreValid = false;
                }
                userScores[sub.id] = val;
            });

            if (!isUserScoreValid) {
                showToast("請確認您輸入的個人得分為有效非負數字", "error");
                return;
            }

            if (totalN < 2) {
                showToast("考試總人數不能少於 2 人", "error");
                return;
            }

            // 計算您自己的「加權總成績」
            let userWeightedTotal = 0;
            subjects.forEach(sub => {
                userWeightedTotal += userScores[sub.id] * (sub.weight / 100);
            });

            const placeholder = document.getElementById('resultPlaceholder');
            const loader = document.getElementById('loader');
            const resultPanel = document.getElementById('resultPanel');
            
            placeholder.classList.add('hidden');
            resultPanel.classList.add('hidden');
            loader.classList.remove('hidden');

            let progress = 0;
            const progressInterval = setInterval(() => {
                progress += 10;
                document.getElementById('loaderProgress').style.width = `${progress}%`;
                if (progress === 20) {
                    document.getElementById('loaderText').innerText = "正在分析多科配分及單科錄取門檻...";
                } else if (progress === 50) {
                    document.getElementById('loaderText').innerText = "正在混合已知考生並利用截斷常態分布擬合母體...";
                } else if (progress === 80) {
                    document.getElementById('loaderText').innerText = `正在跑 ${trials.toLocaleString()} 回合複試同分增額大數據排序...`;
                }

                if (progress >= 100) {
                    clearInterval(progressInterval);
                    setTimeout(() => {
                        executeMonteCarloCore(totalN, qPlanned, qActual, userWeightedTotal, userScores, knowCutoff, cutoffScore, scoreRes, trials);
                    }, 150);
                }
            }, 60);
        }

        function executeMonteCarloCore(N, Q_planned, Q_actual, userW, userScores, knowCutoff, Cutoff, scoreRes, trials) {
            // 1. 整合出已知考生數組 (已知考生名單 K)
            const K = []; 
            
            if (currentInputMode === 'row') {
                // 同行多科模式
                parsedCandidatesRows.forEach(row => {
                    const rowScores = {};
                    subjects.forEach((sub, idx) => {
                        // 若輸入長度大於科目索引，保留其值 (可以是有效數字或 null)；否則設為 null
                        const val = idx < row.length ? row[idx] : null;
                        rowScores[sub.id] = val;
                    });
                    K.push({ scores: rowScores });
                });
            } else {
                // 分科貼上模式
                const colDataLocal = parseColInput();
                let maxLen = 0;
                subjects.forEach(sub => {
                    const len = colDataLocal[sub.id] ? colDataLocal[sub.id].length : 0;
                    if (len > maxLen) maxLen = len;
                });

                for (let i = 0; i < maxLen; i++) {
                    const rowScores = {};
                    subjects.forEach(sub => {
                        const scores = colDataLocal[sub.id];
                        const val = (scores && i < scores.length) ? scores[i] : null;
                        rowScores[sub.id] = val;
                    });
                    K.push({ scores: rowScores });
                }
            }

            const kCount = K.length;
            
            // 計算各考科的先驗貝氏統計量 (用於補足缺失值或未知考生成績)
            const subStats = {};
            subjects.forEach(sub => {
                const validScores = [];
                K.forEach(cand => {
                    if (cand.scores[sub.id] !== null) {
                        validScores.push(cand.scores[sub.id]);
                    }
                });

                const kCountSub = validScores.length;
                let mean = getMean(validScores);
                let std = getStdDev(validScores, mean);

                let defaultMean = 75; 
                let defaultStd = 10;  

                if (sub.dist === 'bounded') {
                    defaultMean = 80;
                    defaultStd = 3.5;
                }

                if (kCountSub === 0) {
                    mean = defaultMean;
                    std = defaultStd;
                } else {
                    mean = (mean * kCountSub + defaultMean * 5) / (kCountSub + 5);
                    if (kCountSub < 2) {
                        std = defaultStd;
                    } else {
                        std = (std * kCountSub + defaultStd * 8) / (kCountSub + 8);
                    }
                }

                if (sub.dist === 'bounded') {
                    std = Math.max(1.5, Math.min(5, std));
                } else {
                    std = Math.max(4, Math.min(18, std));
                }

                subStats[sub.id] = { mean, std };
            });

            // 精度設定
            let step = 0.1;
            if (scoreRes === 'auto') {
                const allNumbers = [userW];
                subjects.forEach(sub => {
                    allNumbers.push(userScores[sub.id]);
                    K.forEach(c => { if (c.scores[sub.id] !== null) allNumbers.push(c.scores[sub.id]); });
                });
                let maxDecimals = 0;
                allNumbers.forEach(n => {
                    const str = n.toString();
                    if (str.includes('.')) {
                        const d = str.split('.')[1].length;
                        if (d > maxDecimals) maxDecimals = d;
                    }
                });
                step = maxDecimals === 0 ? 1.0 : (maxDecimals === 1 ? 0.5 : 0.1);
            } else if (scoreRes !== 'continuous') {
                step = parseFloat(scoreRes);
            }

            function roundValue(val, distMode) {
                if (scoreRes === 'continuous') {
                    if (distMode === 'bounded') return Math.max(70, Math.min(90, val));
                    return Math.max(0, Math.min(100, val));
                }
                const rounded = Math.round(val / step) * step;
                if (distMode === 'bounded') return Math.max(70, Math.min(90, rounded));
                return Math.max(0, Math.min(100, rounded));
            }

            // 規模調控
            let simN = N;
            let simQ_planned = Q_planned;
            let simQ_actual = Q_actual;
            let scaleFactor = 1;
            
            const maxTotalOperations = 3000000;
            if (N * trials > maxTotalOperations) {
                simN = Math.min(N, Math.max(120, Math.floor(maxTotalOperations / trials)));
                scaleFactor = N / simN;
                simQ_planned = Math.max(1, Math.round(Q_planned / scaleFactor));
                simQ_actual = Math.max(simQ_planned, Math.round(Q_actual / scaleFactor));
            }

            const simUnknownCount = simN - kCount - 1;

            // 萬能平移校準 (擬合錄取總分數線 - 直接修正加權總分，使單科截斷分佈與門檻不受干擾！)
            let shiftDelta = 0;
            if (knowCutoff) {
                const calibrateTotals = [];
                for (let i = 0; i < 3000; i++) {
                    let totalWeighted = 0;
                    subjects.forEach(sub => {
                        let s = generateSubjectScoreWithThreshold(sub, subStats[sub.id]);
                        s = roundValue(s, sub.dist);
                        totalWeighted += s * (sub.weight / 100);
                    });
                    calibrateTotals.push(totalWeighted);
                }
                calibrateTotals.sort((a, b) => a - b);
                
                const kAbove = K.map(cand => {
                    let wt = 0;
                    subjects.forEach(sub => {
                        const val = cand.scores[sub.id] !== null ? cand.scores[sub.id] : subStats[sub.id].mean;
                        wt += val * (sub.weight / 100);
                    });
                    return wt;
                }).filter(wt => wt >= Cutoff).length;

                const userAbove = userW >= Cutoff ? 1 : 0;
                const qUnknown = Math.max(0, Q_actual - kAbove - userAbove);
                const realUnknownCount = N - kCount - 1;

                let targetProp = realUnknownCount > 0 ? (qUnknown / realUnknownCount) : 0;
                targetProp = Math.max(0, Math.min(1, targetProp));

                const targetPercentileValue = getPercentile(calibrateTotals, 1 - targetProp);
                shiftDelta = Cutoff - targetPercentileValue;
            }

            // 單一虛擬考生成績生成器 (已校準與級距化)
            function generateVirtualCandidateWeighted() {
                let totalWeighted = 0;
                subjects.forEach(sub => {
                    let s = generateSubjectScoreWithThreshold(sub, subStats[sub.id]);
                    s = roundValue(s, sub.dist);
                    totalWeighted += s * (sub.weight / 100);
                });
                
                if (knowCutoff) {
                    totalWeighted += shiftDelta; // 智慧型直接將 Delta 平移作用於總分，不干擾單科的截斷完整度
                }
                
                return Math.max(0, Math.min(100, totalWeighted));
            }

            // 蒙地卡羅模擬主循環
            const simulatedRanks = new Array(trials);
            let passCount = 0;
            let sumCutoffScore = 0;

            for (let t = 0; t < trials; t++) {
                // 1. 生成完全未知的考生成績
                const simulatedWeightedTotals = [];
                for (let i = 0; i < simUnknownCount; i++) {
                    simulatedWeightedTotals.push(generateVirtualCandidateWeighted());
                }

                // 2. 結合已知考生 (若有特定科目缺失，動態隨機補足該科目並嚴格遵守單科錄取門檻！)
                const roundedKWeighted = K.map(cand => {
                    let wt = 0;
                    subjects.forEach(sub => {
                        let s = cand.scores[sub.id];
                        if (s === null) {
                            s = generateSubjectScoreWithThreshold(sub, subStats[sub.id]);
                        }
                        s = roundValue(s, sub.dist);
                        wt += s * (sub.weight / 100);
                    });
                    return wt;
                });

                // 3. 合併自己
                const fullPool = [...simulatedWeightedTotals, ...roundedKWeighted, userW];

                // 4. 排序 (降序)
                fullPool.sort((a, b) => b - a);

                // 5. 定位錄取分數與同分束擬合
                const cutoffIndex = Math.min(fullPool.length - 1, simQ_planned - 1);
                const S_cutoff = fullPool[cutoffIndex];

                let L = fullPool.indexOf(S_cutoff);
                let R = fullPool.lastIndexOf(S_cutoff);

                const targetR = Math.max(R, simQ_actual - 1);
                for (let i = L; i <= targetR; i++) {
                    if (i < fullPool.length) {
                        fullPool[i] = S_cutoff;
                    }
                }

                // 6. 錄取判定與名次計算
                const isAdmitted = userW >= S_cutoff;
                if (isAdmitted) {
                    passCount++;
                }

                const strictlyHigherCount = fullPool.filter(score => score > userW).length;
                const myRank = strictlyHigherCount + 1;

                const restoredRank = Math.max(1, Math.round(myRank * scaleFactor));
                simulatedRanks[t] = restoredRank;

                sumCutoffScore += S_cutoff;
            }

            // 統計與整合
            simulatedRanks.sort((a, b) => a - b);
            const medianRank = Math.round(getPercentile(simulatedRanks, 0.5));
            const rankLow = Math.round(getPercentile(simulatedRanks, 0.05));
            const rankHigh = Math.round(getPercentile(simulatedRanks, 0.95));

            const admissionProb = (passCount / trials) * 100;
            const beatenPeople = Math.max(0, N - medianRank);
            const beatenRate = (beatenPeople / N) * 100;

            const finalCutoff = knowCutoff ? Cutoff : (sumCutoffScore / trials);

            // 求總成績母體特徵統計量
            let sampleSums = 0;
            let sampleCount = 500;
            const testBatch = [];
            for (let i = 0; i < sampleCount; i++) {
                const val = generateVirtualCandidateWeighted();
                testBatch.push(val);
                sampleSums += val;
            }
            const sampleMean = sampleSums / sampleCount;
            const sampleStd = getStdDev(testBatch, sampleMean);

            lastAnalysisResult = {
                N, Q_planned, Q_actual, U: userW, MaxS: 100, knowCutoff, Cutoff, trials, step, scoreRes,
                medianRank, rankLow, rankHigh,
                admissionProb, beatenPeople, beatenRate,
                finalCutoff, kMean: sampleMean, kStd: sampleStd, KCount: kCount,
                generateVirtualCandidateWeighted
            };

            renderResults(lastAnalysisResult);
        }

        // --- 7. 數據與 UI 渲染 ---
        function renderResults(res) {
            document.getElementById('loader').classList.add('hidden');
            document.getElementById('resultPanel').classList.remove('hidden');

            // 1. 名次落點
            document.getElementById('resRankRange').innerHTML = `第 <span class="text-3xl font-black text-violet-700">${res.rankLow}</span> ~ <span class="text-3xl font-black text-violet-700">${res.rankHigh}</span> 名`;
            document.getElementById('resAvgRank').innerText = `最可能排名：第 ${res.medianRank} 名 (全場排名前 ${(res.medianRank/res.N*100).toFixed(1)}%)`;

            // 2. 錄取機率
            const probText = res.admissionProb.toFixed(1);
            document.getElementById('resProbText').innerText = `${probText} %`;
            
            const badge = document.getElementById('resProbBadge');
            const ringColor = document.getElementById('resProbCircle');
            if (res.admissionProb >= 85) {
                badge.innerText = "極高機率 🌟";
                badge.className = "inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold mt-2 bg-emerald-100 text-emerald-800";
                ringColor.className = "text-emerald-500 transition-all duration-500";
            } else if (res.admissionProb >= 50) {
                badge.innerText = "中高機會 👍";
                badge.className = "inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold mt-2 bg-blue-100 text-blue-800";
                ringColor.className = "text-blue-500 transition-all duration-500";
            } else if (res.admissionProb >= 20) {
                badge.innerText = "邊緣拉鋸 ⚖️";
                badge.className = "inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold mt-2 bg-amber-100 text-amber-800";
                ringColor.className = "text-amber-500 transition-all duration-500";
            } else {
                badge.innerText = "形勢嚴峻 ⚠️";
                badge.className = "inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold mt-2 bg-rose-100 text-rose-800";
                ringColor.className = "text-rose-500 transition-all duration-500";
            }

            document.getElementById('resProbCircle').setAttribute('stroke-dasharray', `${probText}, 100`);
            document.getElementById('resProbCircleText').innerText = `${Math.round(res.admissionProb)}%`;

            // 3. 擊敗比例
            document.getElementById('resBeatenRate').innerText = `${res.beatenRate.toFixed(1)} %`;
            document.getElementById('resBeatenText').innerText = `領先全考場約 ${res.beatenPeople} 人`;

            // 4. 下方圖例統計
            document.getElementById('infoStats').innerText = `${res.kMean.toFixed(1)} 分 / ${res.kStd.toFixed(1)} 分`;
            document.getElementById('infoCutoff').innerText = `${res.finalCutoff.toFixed(1)} 分`;
            document.getElementById('infoQuota').innerText = `${res.Q_planned} / ${res.Q_actual} 人`;
            document.getElementById('infoTrials').innerText = `${res.trials.toLocaleString()} 次`;

            // 5. AI 分析報告
            const aiTextEl = document.getElementById('aiAnalysisText');
            let diagnosis = `<p>您的綜合加權分數 <strong>${res.U.toFixed(2)} 分</strong>，相對於二試多考科採計設定，評估結果如下：</p>`;
            
            const tieDiff = res.Q_actual - res.Q_planned;
            let tieDesc = "";
            if (tieDiff > 0) {
                tieDesc = `（已考量增設的 <strong>${tieDiff} 名複試同分增額名額限制</strong>）`;
            }

            if (res.U >= res.finalCutoff) {
                const margin = res.U - res.finalCutoff;
                diagnosis += `<p>🟢 您的總積分目前 <strong>領先錄取總分線約 ${margin.toFixed(2)} 分</strong>。在 <strong>${res.trials.toLocaleString()} 次</strong> 二試加權隨機分發模擬下，上榜率高達 <strong>${res.admissionProb.toFixed(1)}%</strong> ${tieDesc}。您的加權總名次落點預估為第 <strong>${res.rankLow} 至 ${res.rankHigh}</strong> 名。</p>`;
            } else {
                const margin = res.finalCutoff - res.U;
                diagnosis += `<p>🔴 您的總積分目前 <strong>落後估計錄取總分線約 ${margin.toFixed(2)} 分</strong>。在模擬中，您的錄取機會為 <strong>${res.admissionProb.toFixed(1)}%</strong> ${tieDesc}。加權名次落點大約在第 <strong>${res.rankLow} 至 ${res.rankHigh}</strong> 名之間。</p>`;
            }

            // 說明是否有啟用單科門檻
            const activeThresholds = subjects.filter(sub => sub.threshold > 0);
            if (activeThresholds.length > 0) {
                diagnosis += `<p>🛡️ 模擬已成功啟用單科錄取門檻：`;
                activeThresholds.forEach((sub, idx) => {
                    diagnosis += `${idx > 0 ? '、' : ''}<strong>${sub.name} &ge; ${sub.threshold} 分</strong>`;
                });
                diagnosis += `。所有模擬產出的考生皆會被限制在此成績之上，大幅擬真了複試階段考生的基本筆試水準！</p>`;
            }

            if (res.scoreRes !== 'continuous') {
                diagnosis += `<p>📐 系統已自動對各考科套用離散精度級距（分數最小單位：<strong>${res.step} 分</strong>），這大幅提高了考科臨界點同分相撞機率的逆真度。</p>`;
            }

            if (res.KCount > 0) {
                diagnosis += `<p>📊 模擬已排除或補全您輸入的 <strong>${res.KCount} 筆已知考生複試分數</strong> 作為固定樣本，極大校正了各分科的貝氏標準差。若能取得更多同儕的各科分數，名次將會收斂得更加窄細與準確。</p>`;
            } else {
                diagnosis += `<p>💡 您目前並未提供任何其他考生的具體複試分數。當前分佈純依賴所選的分佈模型。若能收集到幾位考生的成績並填入，結果會更加精準！</p>`;
            }

            aiTextEl.innerHTML = diagnosis;

            // 6. 繪製畫布
            drawResultChart(res);
        }

        // --- 8. Canvas 繪製密度分佈圖 ---
        function clearCanvas() {
            const canvas = document.getElementById('distCanvas');
            const ctx = canvas.getContext('2d');
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * window.devicePixelRatio;
            canvas.height = rect.height * window.devicePixelRatio;
            ctx.scale(window.devicePixelRatio, window.devicePixelRatio);

            ctx.clearRect(0, 0, rect.width, rect.height);
            ctx.fillStyle = '#8b5cf6';
            ctx.font = '13px "Noto Sans TC"';
            ctx.textAlign = 'center';
            ctx.fillText('暫無模擬數據，請點擊「開始複試模擬」', rect.width / 2, rect.height / 2);
        }

        function drawResultChart(res) {
            const canvas = document.getElementById('distCanvas');
            const ctx = canvas.getContext('2d');
            
            const rect = canvas.getBoundingClientRect();
            const width = rect.width;
            const height = rect.height;
            
            canvas.width = width * window.devicePixelRatio;
            canvas.height = height * window.devicePixelRatio;
            ctx.scale(window.devicePixelRatio, window.devicePixelRatio);

            ctx.clearRect(0, 0, width, height);

            const padding = { top: 35, right: 30, bottom: 40, left: 50 };
            const chartWidth = width - padding.left - padding.right;
            const chartHeight = height - padding.top - padding.bottom;

            // 構建整體加權密度 KDE 大樣本 (8000 點)
            const tempSamples = [];
            for (let i = 0; i < 8000; i++) {
                tempSamples.push(res.generateVirtualCandidateWeighted());
            }

            const bw = res.kStd * 0.22;

            function gaussianKernel(x) {
                return Math.exp(-0.5 * x * x) / Math.sqrt(2 * Math.PI);
            }

            function getKDE(val) {
                let sum = 0;
                for (let i = 0; i < tempSamples.length; i++) {
                    sum += gaussianKernel((val - tempSamples[i]) / bw);
                }
                return sum / (tempSamples.length * bw);
            }

            // 採樣 120 個點
            const pointsCount = 120;
            const xs = [];
            const ys = [];
            for (let i = 0; i <= pointsCount; i++) {
                const score = (res.MaxS / pointsCount) * i;
                xs.push(score);
                ys.push(getKDE(score));
            }

            const maxY = Math.max(...ys) * 1.15;

            function getXPix(score) {
                return padding.left + (score / res.MaxS) * chartWidth;
            }
            function getYPix(density) {
                return padding.top + chartHeight - (density / maxY) * chartHeight;
            }

            // 網格底線
            ctx.strokeStyle = '#f1f5f9';
            ctx.lineWidth = 1;
            for (let i = 1; i <= 5; i++) {
                const yVal = padding.top + (chartHeight / 5) * i;
                ctx.beginPath();
                ctx.moveTo(padding.left, yVal);
                ctx.lineTo(width - padding.right, yVal);
                ctx.stroke();
            }

            const cutoffX = res.finalCutoff;
            
            // 著色：未錄取區 (低於 Cutoff)
            ctx.fillStyle = 'rgba(241, 245, 249, 0.85)';
            ctx.beginPath();
            ctx.moveTo(getXPix(0), getYPix(0));
            for (let i = 0; i <= pointsCount; i++) {
                const xVal = xs[i];
                if (xVal <= cutoffX) {
                    ctx.lineTo(getXPix(xVal), getYPix(ys[i]));
                }
            }
            ctx.lineTo(getXPix(Math.min(res.MaxS, cutoffX)), getYPix(0));
            ctx.closePath();
            ctx.fill();

            // 著色：已錄取區 (高於 Cutoff)
            const greenGradient = ctx.createLinearGradient(0, padding.top, 0, padding.top + chartHeight);
            greenGradient.addColorStop(0, 'rgba(16, 185, 129, 0.25)');
            greenGradient.addColorStop(1, 'rgba(16, 185, 129, 0.02)');
            ctx.fillStyle = greenGradient;
            
            ctx.beginPath();
            ctx.moveTo(getXPix(cutoffX), getYPix(0));
            let startDrawing = false;
            for (let i = 0; i <= pointsCount; i++) {
                const xVal = xs[i];
                if (xVal >= cutoffX) {
                    if (!startDrawing) {
                        ctx.lineTo(getXPix(xVal), getYPix(ys[i]));
                        startDrawing = true;
                    } else {
                        ctx.lineTo(getXPix(xVal), getYPix(ys[i]));
                    }
                }
            }
            ctx.lineTo(getXPix(res.MaxS), getYPix(0));
            ctx.closePath();
            ctx.fill();

            // 繪製外圍加權密度線
            ctx.strokeStyle = '#8b5cf6'; 
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.moveTo(getXPix(xs[0]), getYPix(ys[0]));
            for (let i = 1; i <= pointsCount; i++) {
                ctx.lineTo(getXPix(xs[i]), getYPix(ys[i]));
            }
            ctx.stroke();

            // 軸線
            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(padding.left, padding.top + chartHeight);
            ctx.lineTo(width - padding.right, padding.top + chartHeight);
            ctx.stroke();

            // 刻度
            ctx.fillStyle = '#64748b';
            ctx.font = '10px "Noto Sans TC"';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'top';
            const tickStep = res.MaxS >= 500 ? 100 : (res.MaxS >= 200 ? 50 : 10);
            for (let i = 0; i <= res.MaxS; i += tickStep) {
                const x = getXPix(i);
                ctx.fillText(`${i}分`, x, padding.top + chartHeight + 6);
                ctx.beginPath();
                ctx.moveTo(x, padding.top + chartHeight);
                ctx.lineTo(x, padding.top + chartHeight + 4);
                ctx.stroke();
            }

            // 錄取線 (Cutoff)
            ctx.strokeStyle = '#f43f5e';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.moveTo(getXPix(cutoffX), padding.top - 5);
            ctx.lineTo(getXPix(cutoffX), padding.top + chartHeight);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = '#e11d48';
            ctx.font = 'bold 10px "Noto Sans TC"';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'bottom';
            ctx.fillText(`最低錄取: ${cutoffX.toFixed(2)}分`, getXPix(cutoffX), padding.top - 8);

            // 您自己的分數線
            const myX = getXPix(res.U);
            ctx.strokeStyle = '#10b981';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.moveTo(myX, padding.top - 5);
            ctx.lineTo(myX, padding.top + chartHeight);
            ctx.stroke();

            ctx.fillStyle = '#10b981';
            ctx.beginPath();
            ctx.arc(myX, getYPix(getKDE(res.U)), 5, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#047857';
            ctx.font = 'bold 11px "Noto Sans TC"';
            const textOffset = Math.abs(res.U - cutoffX) < (res.MaxS * 0.06) ? (res.U < cutoffX ? -32 : 32) : 0;
            ctx.textAlign = textOffset === 0 ? 'center' : (textOffset < 0 ? 'right' : 'left');
            ctx.textBaseline = 'bottom';
            ctx.fillText(`您的分數: ${res.U.toFixed(2)}分`, myX + textOffset, padding.top - 20);

            // 右下角強浮水印
            ctx.fillStyle = 'rgba(148, 163, 184, 0.55)';
            ctx.font = '9px "Noto Sans TC"';
            ctx.textAlign = 'right';
            ctx.textBaseline = 'bottom';
            ctx.fillText('以上電腦模擬分析僅供參考，不表示真實情況。', width - 8, height - 6);
        }
    </script>
