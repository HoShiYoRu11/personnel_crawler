<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我是第幾名？考試落點模擬分析系統－複試版</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700;900&display=swap');
        body {
            font-family: 'Noto Sans TC', sans-serif;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800 custom-scrollbar">

    <!-- 頂部導覽列 -->
    <header class="bg-gradient-to-r from-violet-700 via-indigo-600 to-purple-800 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 py-5 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <span class="text-3xl">🎯</span>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight">我是第幾名？</h1>
                    <p class="text-xs text-indigo-200 mt-0.5">考試落點模擬分析系統－複試版</p>
                </div>
            </div>
            <div class="bg-white/10 px-4 py-2 rounded-lg text-xs backdrop-blur-sm border border-white/10 max-w-md text-center sm:text-right">
                ⚠️ <span class="font-medium text-amber-200">免責聲明：</span>以上電腦模擬分析僅供參考，不表示真實情況，亦不具備官方錄取效力。
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
        <!-- 複試版核心導讀 -->
        <div class="bg-violet-50 border-l-4 border-violet-500 p-4 rounded-r-lg mb-8 shadow-sm">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-xs sm:text-sm text-violet-800 leading-relaxed">
                        <strong>複試智慧採計優勢：</strong>本系統支援<strong>「單科錄取分數下限（門檻）」</strong>與<strong>「單科已知、單科未知」</strong>的高階截斷模擬。若您設定了初試科目門檻（如 65 分），系統在模擬其餘考生時，會自動剔除不合規分數，完美再現「複試考場皆為過關精英」的真實競爭環境！
                    </p>
                </div>
            </div>
        </div>

        <!-- 主區塊：左側輸入、右側結果 -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- 左側：參數輸入區 -->
            <section class="lg:col-span-5 space-y-6">
                
                <!-- 卡片 1：基本規模設定 -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center gap-2">
                        <span class="text-lg">⚙️</span>
                        <h2 class="font-bold text-slate-800 text-sm sm:text-base">1. 設定考試基本規模</h2>
                    </div>
                    <div class="p-5 space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <div>
                                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">考試總人數 (N)</label>
                                <input type="number" id="totalCandidates" value="25" min="2" max="1000000"
                                    class="w-full px-3 py-1.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm font-semibold">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">原定錄取名額</label>
                                <input type="number" id="quotaPlanned" value="8" min="1"
                                    class="w-full px-3 py-1.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">實際(含增額)名額</label>
                                <input type="number" id="quotaActual" value="8" min="1"
                                    class="w-full px-3 py-1.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm">
                            </div>
                        </div>
                        
                        <!-- 複試規模提示文字 -->
                        <p class="text-[10px] text-indigo-600 bg-indigo-50 p-2.5 rounded-lg leading-relaxed">
                            💡 <strong>複試小秘訣：</strong>此處的 <strong>總人數 (N)</strong> 應填寫「進入複試階段的總人數」（例如初試篩選後剩 25 人進入二試，則 N 填 25），不需計入已被初試淘汰的考生。
                        </p>

                        <!-- 錄取總分 Cutoff 勾選 -->
                        <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs">
                            <label for="knowCutoff" class="flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" id="knowCutoff" class="w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500">
                                <span class="font-medium text-slate-700">我知道最後「最低錄取總分數（加權後）」</span>
                            </label>
                            <div id="cutoffWrapper" class="mt-2 hidden">
                                <input type="number" id="cutoffScore" value="78.5" min="0" max="1000" step="any"
                                    class="w-full px-3 py-1.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm"
                                    placeholder="請輸入加權後的最低錄取總分">
                                <p class="text-[10px] text-slate-400 mt-1">💡 系統將利用此加權總分，逆向精密校準各科模擬隨機母體的分佈高度！</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 卡片 2：考科與權重配分設定 -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <span class="text-lg">📋</span>
                            <h2 class="font-bold text-slate-800 text-sm sm:text-base">2. 編輯採計科目與模擬分佈</h2>
                        </div>
                        <button type="button" id="btnAddSubject" class="text-xs bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold px-2.5 py-1 rounded-lg border border-indigo-200 transition-all">
                            ＋ 新增科目
                        </button>
                    </div>
                    <div class="p-5 space-y-4">
                        <!-- 科目列表容器 -->
                        <div id="subjectsList" class="space-y-3">
                            <!-- 動態生成 -->
                        </div>

                        <!-- 權重加總檢查欄 -->
                        <div class="flex justify-between items-center p-3 rounded-xl border" id="weightCheckBar">
                            <span class="text-xs font-bold text-slate-500">配分權重總和：</span>
                            <span class="text-sm font-black" id="totalWeightVal">0%</span>
                        </div>
                    </div>
                </div>

                <!-- 卡片 3：您的各科得分 -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center gap-2">
                        <span class="text-lg">👤</span>
                        <h2 class="font-bold text-slate-800 text-sm sm:text-base">3. 輸入您自己的得分</h2>
                    </div>
                    <div class="p-5">
                        <div id="userScoreContainer" class="grid grid-cols-2 gap-4">
                            <!-- 動態生成您的得分輸入框 -->
                        </div>
                    </div>
                </div>

                <!-- 卡片 4：其他考生分數 -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                        <div class="flex items-center gap-2">
                            <span class="text-lg">👥</span>
                            <h2 class="font-bold text-slate-800 text-sm sm:text-base">4. 其他考生已知分數</h2>
                        </div>
                        <!-- 輸入模式切換 -->
                        <div class="flex bg-slate-100 p-0.5 rounded-lg border border-slate-200">
                            <button type="button" id="btnModeRow" class="text-xs px-2.5 py-1 rounded-md font-medium bg-white text-slate-800 shadow-sm transition-all">同行多科</button>
                            <button type="button" id="btnModeCol" class="text-xs px-2.5 py-1 rounded-md font-medium text-slate-500 hover:text-slate-800 transition-all">分科貼上</button>
                        </div>
                    </div>
                    
                    <div class="p-5 space-y-4">
                        <!-- 模式 A：同行多科 (CSV) -->
                        <div id="inputModeRowContainer" class="space-y-2">
                            <div class="flex justify-between items-center">
                                <span class="text-xs text-slate-400">一行為一位考生，未知科目請填問號 <code>?</code> 或留空</span>
                                <span id="rowParsedCount" class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded">已識別 0 筆</span>
                            </div>
                            <textarea id="otherScoresRow" rows="5"
                                class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-xs font-mono"
                                placeholder="例如（若設定3科，可用問號代表其中某科未知分數）：
82, ?, 88  (代表該考生第二科分數未知)
79, 81, 74
85, 78, ?  (第三科未知，將由系統模擬補全)"></textarea>
                        </div>

                        <!-- 模式 B：分科獨立貼上 -->
                        <div id="inputModeColContainer" class="hidden space-y-3">
                            <p class="text-xs text-slate-400">請在各科貼上已知的零散分數（不同科目名單長度可不同，缺失部分由系統自動補全）：</p>
                            <div id="subjectPasteInputs" class="space-y-3">
                                <!-- 動態生成各科貼上框 -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 卡片 5：高階模擬設定與按鈕 -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">分數最小精度級距</label>
                            <select id="scoreResolution" class="w-full px-3 py-1.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-xs bg-white">
                                <option value="auto">自動判定 (依輸入)</option>
                                <option value="1">1 分 (整數)</option>
                                <option value="0.5">0.5 分</option>
                                <option value="0.1">0.1 分</option>
                                <option value="continuous" selected>無限制 (連續值)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">模擬重複次數</label>
                            <select id="simTrials" class="w-full px-3 py-1.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-xs bg-white">
                                <option value="10000" selected>10,000 次 (高精模擬)</option>
                                <option value="50000">50,000 次 (深度演算)</option>
                                <option value="100000">100,000 次 (極致演算)</option>
                            </select>
                        </div>
                    </div>

                    <button type="button" id="btnSimulate"
                        class="w-full bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-700 hover:to-indigo-700 text-white font-bold py-3 px-4 rounded-xl shadow-md hover:shadow-lg transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 flex items-center justify-center gap-2 text-base">
                        <span>🚀 開始跑複試蒙地卡羅模擬</span>
                    </button>
                </div>

            </section>

            <!-- 右側：結果儀表板 -->
            <section class="lg:col-span-7 flex flex-col justify-between">
                
                <!-- 初始狀態佔位 -->
                <div id="resultPlaceholder" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-12 text-center flex-1 flex flex-col items-center justify-center min-h-[550px]">
                    <span class="text-6xl mb-4 animate-bounce">📊</span>
                    <h3 class="text-xl font-bold text-slate-700 mb-2">等待模擬啟動</h3>
                    <p class="text-sm text-slate-400 max-w-sm">請於左側自訂您的複試科目、配分及各科錄取門檻，填寫您自己的得分後，按下「開始跑複試蒙地卡羅模擬」按鈕。</p>
                </div>

                <!-- 模擬跑條動效 -->
                <div id="loader" class="hidden bg-white rounded-2xl shadow-sm border border-slate-200 p-12 text-center flex-1 flex flex-col items-center justify-center min-h-[550px]">
                    <div class="relative w-20 h-20 mb-6">
                        <div class="absolute inset-0 border-4 border-slate-100 rounded-full"></div>
                        <div class="absolute inset-0 border-4 border-violet-600 border-t-transparent rounded-full animate-spin"></div>
                    </div>
                    <h3 id="loaderText" class="text-lg font-bold text-slate-800 mb-1">正在初始化模擬母體...</h3>
                    <div class="w-64 bg-slate-100 h-2 rounded-full overflow-hidden mt-3">
                        <div id="loaderProgress" class="bg-violet-600 h-full w-0 transition-all duration-100"></div>
                    </div>
                </div>

                <!-- 模擬結果面板 (計算完畢顯示) -->
                <div id="resultPanel" class="hidden space-y-6 flex-1">
                    <!-- 核心統計數據卡片 -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- 名次區間 -->
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-24 h-24 -mr-6 -mt-6 bg-violet-50 rounded-full -z-0 opacity-50"></div>
                            <div class="relative z-10">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">預估加權總名次</span>
                                <div class="text-2xl font-black text-violet-700" id="resRankRange">第 -- ~ -- 名</div>
                                <p class="text-[11px] text-slate-500 mt-2" id="resAvgRank">最可能排名：第 -- 名</p>
                            </div>
                        </div>

                        <!-- 錄取機率 -->
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between relative overflow-hidden">
                            <div>
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">綜合錄取機率</span>
                                <div class="text-3xl font-black" id="resProbText">-- %</div>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium mt-2" id="resProbBadge">--</span>
                            </div>
                            <div class="relative w-16 h-16">
                                <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                                    <path class="text-slate-100" stroke-width="3" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    <path id="resProbCircle" class="text-emerald-500" stroke-dasharray="0, 100" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                </svg>
                                <div class="absolute inset-0 flex items-center justify-center text-xs font-bold text-slate-600" id="resProbCircleText">--</div>
                            </div>
                        </div>

                        <!-- 競爭勝出率 -->
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-24 h-24 -mr-6 -mt-6 bg-emerald-50 rounded-full -z-0 opacity-50"></div>
                            <div class="relative z-10">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">擊敗考生比例</span>
                                <div class="text-3xl font-black text-emerald-600" id="resBeatenRate">-- %</div>
                                <p class="text-[11px] text-slate-500 mt-2" id="resBeatenText">領先全考場約 -- 人</p>
                            </div>
                        </div>
                    </div>

                    <!-- 畫布：分佈圖解說 -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-4">
                            <div>
                                <h3 class="text-base font-bold text-slate-800 flex items-center gap-1.5">
                                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-violet-600"></span>
                                    複試加權總分－真實成績密度分佈圖
                                </h3>
                                <p class="text-xs text-slate-400">橫軸為加權後總分，縱軸為模擬之相對人數比例（已區分錄取區與未錄取區）</p>
                            </div>
                            <div class="flex gap-4 text-xs font-medium self-end sm:self-auto">
                                <div class="flex items-center gap-1"><span class="w-3 h-3 bg-emerald-100 border border-emerald-500 rounded-sm"></span>錄取區</div>
                                <div class="flex items-center gap-1"><span class="w-3 h-3 bg-slate-100 border border-slate-400 rounded-sm"></span>未錄取區</div>
                            </div>
                        </div>

                        <!-- Canvas 容器 -->
                        <div class="relative w-full aspect-[16/9] md:aspect-[2.2/1] bg-slate-50 border border-slate-100 rounded-xl overflow-hidden">
                            <canvas id="distCanvas" class="w-full h-full block"></canvas>
                        </div>

                        <!-- 圖例與資訊 -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-4 pt-4 border-t border-slate-100 text-xs text-slate-500">
                            <div>
                                <span class="block text-slate-400">模擬平均總分 / 標準差</span>
                                <span class="font-bold text-slate-700" id="infoStats">-- 分 / -- 分</span>
                            </div>
                            <div>
                                <span class="block text-slate-400">估計最低錄取總分</span>
                                <span class="font-bold text-rose-600" id="infoCutoff">-- 分</span>
                            </div>
                            <div>
                                <span class="block text-slate-400">複試錄取名額(原/實)</span>
                                <span class="font-bold text-violet-600" id="infoQuota">-- / -- 人</span>
                            </div>
                            <div>
                                <span class="block text-slate-400">模擬重複次數</span>
                                <span class="font-bold text-slate-700" id="infoTrials">-- 次</span>
                            </div>
                        </div>
                    </div>

                    <!-- 分析詳情說明 -->
                    <div class="bg-violet-50/50 border border-violet-100 p-5 rounded-2xl">
                        <h4 class="text-sm font-bold text-violet-900 mb-2 flex items-center gap-1.5">
                            ✨ 複試智慧診斷與落點評估
                        </h4>
                        <div id="aiAnalysisText" class="text-xs text-violet-950 leading-relaxed space-y-2">
                            <!-- 動態生成 analysis -->
                        </div>
                    </div>

                    <!-- 免責警告橫幅 -->
                    <div class="bg-amber-50 border border-amber-200 text-amber-900 p-4 rounded-xl text-xs flex items-start gap-2.5">
                        <span class="text-lg">⚠️</span>
                        <div>
                            <strong class="font-bold">統計模擬警告與免責聲明：</strong>
                            <p class="mt-0.5 leading-relaxed text-amber-800">
                                本程式產出之數據皆基於隨機蒙地卡羅法生成，在有限已知資訊與特定統計分佈之假设下進行概率估算。「以上電腦模擬分析僅供參考，不表示真實情況」，請勿將此結果作為選填志願、放棄資格或其他任何重大人生決策之單一依據。真實榜單仍以官方公布為準。
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- 自訂提示 Toast 容器 -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2"></div>

    <!-- 腳本區域 -->
    <script>
        // --- 1. 全域狀態與預設科目 (預設初試成績設有 65 分錄取門檻) ---
        // 應使用者需求：預設科目修改為「初試」(Normal)、「試教」(Bounded 70-90)、「口試」(Bounded 70-90)
        let subjects = [
            { id: 1, name: "初試", weight: 40, dist: "normal", threshold: 65 },
            { id: 2, name: "試教", weight: 30, dist: "bounded", threshold: null },
            { id: 3, name: "口試", weight: 30, dist: "bounded", threshold: null }
        ];
        
        let nextSubjectId = 4;
        let currentInputMode = 'row'; // 'row' (CSV/同一行) or 'col' (分科)

        // 統計輔助函數
        function randomNormal(mean, stdDev) {
            let u = 0, v = 0;
            while(u === 0) u = Math.random();
            while(v === 0) v = Math.random();
            let num = Math.sqrt(-2.0 * Math.log(u)) * Math.cos(2.0 * Math.PI * v);
            return num * stdDev + mean;
        }

        function randomUniform(min, max) {
            return min + Math.random() * (max - min);
        }

        // 三角隨機數
        function randomTriangular(min, max, mode) {
            const u = Math.random();
            const F = (mode - min) / (max - min);
            if (u < F) {
                return min + Math.sqrt(u * (max - min) * (mode - min));
            } else {
                return max - Math.sqrt((1 - u) * (max - min) * (max - mode));
            }
        }

        // 專為評審評分 70-90分 設計的分佈 (口試與試教均值多數落在 80 左右)
        function randomBounded70_90() {
            let score;
            let attempts = 0;
            do {
                score = randomNormal(80.5, 4.2); 
                attempts++;
            } while ((score < 70 || score > 90) && attempts < 100);
            return (score < 70 || score > 90) ? randomUniform(70, 90) : score;
        }

        function getMean(arr) {
            if (!arr.length) return 0;
            return arr.reduce((acc, val) => acc + val, 0) / arr.length;
        }

        function getStdDev(arr, mean) {
            if (arr.length < 2) return 10;
            const variance = arr.reduce((acc, val) => acc + Math.pow(val - mean, 2), 0) / (arr.length - 1);
            return Math.sqrt(variance);
        }

        function getPercentile(sortedArr, p) {
            if (!sortedArr.length) return 0;
            if (p <= 0) return sortedArr[0];
            if (p >= 1) return sortedArr[sortedArr.length - 1];
            const index = p * (sortedArr.length - 1);
            const lower = Math.floor(index);
            const upper = Math.ceil(index);
            const weight = index - lower;
            return sortedArr[lower] * (1 - weight) + sortedArr[upper] * weight;
        }

        // Toast 訊息
        function showToast(message, type = 'info') {
